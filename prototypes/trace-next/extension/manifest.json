{
  "manifest_version": 3,
  "name": "PageAgo · 本地浏览记录",
  "short_name": "PageAgo",
  "version": "0.1.0",
  "description": "用 PageAgo 回看浏览足迹。由你开启，只在本机记录当前活动网页的前台时间。",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "idle", "alarms", "favicon"],
  "incognito": "not_allowed",
  "icons": {"16":"pageago-16.png","32":"pageago-32.png","48":"pageago-48.png","128":"pageago-128.png"},
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "打开 PageAgo", "default_icon": {"16":"pageago-16.png","32":"pageago-32.png","48":"pageago-48.png","128":"pageago-128.png"} },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
